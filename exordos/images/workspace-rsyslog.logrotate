# Workspace guests have a small root disk. Check size hourly and compress at once.
/var/log/syslog
/var/log/kern.log
/var/log/auth.log
/var/log/daemon.log
/var/log/user.log
/var/log/mail.log
/var/log/messages
{
    daily
    maxsize 64M
    rotate 7
    missingok
    notifempty
    compress
    nodelaycompress
    create 0640 syslog adm
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}
