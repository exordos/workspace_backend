# APNs destination for an installation with a Workspace push connector.
name: workspace_apns_push
description: Deliver Workspace iOS push through APNs on the local Notification
schema_version: 1
version: "{{ version | default('1.0.0') }}"
api_version: v1

requirements:
  core:
    from_version: "0.4.3"
  workspace:
    from_version: "3.2.3"
  exordos_notification:
    from_version: "2.0.4-dev"
  notification_apns:
    from_version: "1.0.0"

imports:
  backend_node:
    element: "$workspace"
    kind: resource
    link: "$core.compute.nodes.$workspace_backend"
  apns_provider:
    element: "$notification_apns"
    kind: resource
    link: "$exordos_notification.types.email.providers.$apns"
  event_type_read:
    element: "$exordos_notification"
    kind: resource
    link: "$core.iam.permissions.$event_type_read"
  iam_default_client_uuid:
    element: "$core"
    kind: resource
    link: "$core.vs.variables.$iam_default_client_uuid"
  core_local_domain:
    element: "$core"
    kind: resource
    link: "$core.dns.domains.$local_domain"

resources:
  $exordos_notification.types.email.event_types:
    notification_apns_topic_update:
      uuid: "7e5ec373-6d60-5c40-a362-3f72ee88f905"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: notification_apns_topic_update
      description: Encrypted Workspace topic snapshot for one iOS device
      status: ACTIVE

  $exordos_notification.types.email.templates:
    notification_apns_topic_update:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      name: "Workspace iOS topic update"
      status: ACTIVE
      provider: $workspace_apns_push.imports.$apns_provider:uuid
      event_type: $exordos_notification.types.email.event_types.$notification_apns_topic_update:uuid
      is_default: true
      params: {}
      content:
        kind: apns

  $core.iam.permissions:
    topic_update_create:
      name: exordos_notification.event_type_7e5ec373-6d60-5c40-a362-3f72ee88f905.create
    topic_update_read:
      name: exordos_notification.event_type_7e5ec373-6d60-5c40-a362-3f72ee88f905.read

  $core.iam.roles:
    push_sender:
      name: workspace-apns-push-sender
      project_id: null

  $core.iam.permissionbinding:
    topic_update_create:
      role: $core.iam.roles.$push_sender:uuid
      permission: $core.iam.permissions.$topic_update_create:uuid
      project_id: null
    topic_update_read:
      role: $core.iam.roles.$push_sender:uuid
      permission: $core.iam.permissions.$topic_update_read:uuid
      project_id: null
    event_type_read:
      role: $core.iam.roles.$push_sender:uuid
      permission: $workspace_apns_push.imports.$event_type_read:uuid
      project_id: null

  $core.iam.users:
    push_sender:
      username: workspace-apns-push-sender
      first_name: Workspace
      last_name: APNs
      email: noreply+workspace-apns@exordos.com
      type: service
      password: unused-by-a-service-account

  $core.iam.rolebinding:
    push_sender:
      role: $core.iam.roles.$push_sender:uuid
      user: $core.iam.users.$push_sender:uuid
      project: null

  $core.iam.tokens:
    push_sender:
      name: workspace-apns-push-sender
      user: $core.iam.users.$push_sender:uuid
      iam_client: $workspace_apns_push.imports.$iam_default_client_uuid:value
      issuer: f"http://core.{$workspace_apns_push.imports.$core_local_domain:name}/api/core/v1/iam/clients/{$workspace_apns_push.imports.$iam_default_client_uuid:value}"
      scope: ""
      auto_renew: true
      expiration_delta: 604800

  $core.config.configs:
    enable_apns:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      path: /etc/workspace/workspace.conf.d/92-mobile-apns.conf
      mode: "0600"
      on_change:
        kind: shell
        command: /usr/local/bin/workspace-restart-services
      target:
        kind: node
        node: $workspace_apns_push.imports.$backend_node:uuid
      body:
        kind: text
        content: |
          [mobile_push]
          apns_enabled = true

    authentication:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      path: /etc/workspace/workspace.conf.d/93-mobile-apns-token.conf
      mode: "0600"
      on_change:
        kind: shell
        command: /usr/local/bin/workspace-restart-services --push-sender
      target:
        kind: node
        node: $workspace_apns_push.imports.$backend_node:uuid
      body:
        kind: text
        content: |
          f"
          [mobile_push]
          apns_notification_token = {$core.iam.tokens.$push_sender:access_token}
          "
