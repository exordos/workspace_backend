[Unit]
Description=Workspace Zulip Incoming Events
After=network-online.target

[Service]
TimeoutStopSec=40
Restart=always
RestartSec=5s
KillSignal=SIGINT
ExecStartPre=/bin/sleep 2
ExecStart=workspace-zulip-incoming --config-file /etc/workspace/workspace.conf --config-dir /etc/workspace/workspace.conf.d

[Install]
WantedBy=multi-user.target
