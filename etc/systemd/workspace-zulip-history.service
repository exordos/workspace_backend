[Unit]
Description=Workspace Zulip History Reconciliation
After=network-online.target

[Service]
TimeoutStopSec=40
Restart=always
RestartSec=5s
KillSignal=SIGINT
ExecStartPre=/bin/sleep 2
ExecStart=workspace-zulip-history --config-file /etc/workspace/workspace.conf

[Install]
WantedBy=multi-user.target
