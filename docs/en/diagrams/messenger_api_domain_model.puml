package "1. It 's public . RestAlchemy API\n(The current contract is unchanged .)" as API {
    class "WorkspaceUserMessage\nResourceByRAModel\nController with pagination" as API_MESSAGE
    class "WorkspaceMessageReaction\nResourceByRAModel\nController with pagination" as API_REACTION
    class "WorkspaceUserStream\nResourceByRAModel\nController with pagination" as API_STREAM
    class "WorkspaceUserTopic\nResourceByRAModel\nController with pagination" as API_TOPIC
    class "WorkspaceUserFolder\nResourceByRAModel\nController with pagination" as API_FOLDER
    class "WorkspaceUser\nResourceByRAModel" as API_USER
}

package "2. The simple ones . SQL-Read-only shape adapters" as VIEWS {
    entity "messenger_api_user_messages_v1" as VIEW_MESSAGE {
        placement.uuid AS uuid <<public UUIDv5>>
        user_binding.uuid AS binding_uuid <<Hidden key ORM>>
        message.uuid AS canonical_message_uuid <<Hidden>>
        --
        Access to binding / context of placement
        the user status flags
        Content/author/projection of the message
        created_at/updated_at The message
    }

    entity "messenger_api_user_streams_v1" as VIEW_STREAM {
        One unique user link to the stream
        --
        One canonical stream
        Ready countdowns of unread messages
    }

    entity "messenger_api_user_topics_v1" as VIEW_TOPIC {
        One unique user link to the topic
        --
        One canonical topic
        Ready countdowns of unread messages
    }

    entity "messenger_api_user_folders_v1" as VIEW_FOLDER {
        One unique user binding to the folder
        --
        One canonical folder
        Ready unread_count / mention_count
    }
}

package "3. Project physical SQL-The essence\n(The future migration)" as DOMAIN {
    entity "MESSAGE\nWorkspaceMessage\nmessenger_messages" as MESSAGE {
        uuid : UUID <<PK, The internal canonical ID>>
        project_id
        author_uuid
        payload
        source / provider / delivery
        provider_realm_uuid / provider_message_id <<hidden>>
        reactions / reaction_users
        created_at : public time stamp
        updated_at : public time stamp
    }

    entity "MESSAGE_PLACEMENT\nWorkspaceMessagePlacement\nmessenger_message_placements" as MESSAGE_PLACEMENT {
        uuid : UUID <<public UUIDv5>>
        message_uuid : UUID <<FK>>
        stream_uuid
        topic_uuid
        It 's unique .: Project + message + stream + topic
    }

    entity "USER_MESSAGE_BINDING\nWorkspaceUserMessageBinding\nmessenger_user_message_bindings" as USER_MESSAGE_BINDING {
        binding_uuid : UUID <<Hidden key ORM>>
        placement_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        relation_role
        visibility
        permissions
        membership_generation : int <<snapshot>>
        It 's unique .: Project + location + user
        --
        without version revision
    }

    entity "USER_MESSAGE_STATE\nWorkspaceUserMessageState\nmessenger_user_message_states" as USER_MESSAGE_STATE {
        placement_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        membership_generation : int <<snapshot>>
        read / mentioned / starred / pinned
        It 's unique .: Project + user + location
    }

    entity "MESSAGE_REACTION_FACT\nWorkspaceMessageReactionFact" as REACTION_FACT {
        uuid : UUID <<PK>>
        project_id
        canonical_message_uuid : UUID <<It 's canonical . FK>>
        user_uuid : UUID <<FK The author of the reaction>>
        emoji_name
        --
        It 's unique .: Project + message + user + emoji
    }

    entity "WorkspaceUser\nmessenger_users" as USER {
        user_uuid : UUID <<PK>>
    }

    entity "WorkspaceStream\nmessenger_streams" as STREAM {
        stream_uuid : UUID <<PK>>
        owner_uuid : UUID <<- It 's indexed . FK The user>>
        direct_user_uuid : UUID <<The one that lets in null FK The user>>
        private
        is_archived
        canonical fields of the stream
    }

    entity "WorkspaceStreamBinding\nmessenger_stream_bindings" as STREAM_BINDING {
        binding_uuid : UUID <<PK>>
        user_uuid : UUID <<FK>>
        stream_uuid : UUID <<FK>>
        role / the notification
        active / membership_generation
        Unread message counters / last_message_uuid
    }

    entity "WorkspaceStreamTopic\nmessenger_topics" as TOPIC {
        topic_uuid : UUID <<PK>>
        project_id
        stream_uuid : UUID <<FK>>
        canonical topic fields
    }

    entity "USER_TOPIC_BINDING\nmessenger_user_topic_bindings" as TOPIC_BINDING {
        topic_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        flags / notifications / counting of unread messages
        It 's unique .: Project + user + topic
    }

    entity "FOLDER\nmessenger_folders" as FOLDER
    entity "USER_FOLDER_BINDING\nmessenger_user_folder_bindings" as FOLDER_BINDING {
        folder_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        rule / type
        unread_count / mention_count
        folder_items_snapshot : JSONB <<read-only>>
        snapshot_version / snapshot_updated_at <<internal>>
        It 's unique .: Project + user + folder
    }

    entity "FOLDER_ITEM\nmessenger_folder_items" as FOLDER_ITEM {
        folder_uuid : UUID <<FK>>
        stream_uuid : UUID <<FK>>
        automatic
        It 's unique .: Project + user + folder + stream
    }

    entity "DOMAIN_OUTBOX_EVENT\n- It 's unchanged ." as OUTBOX_EVENT
    entity "PROJECTION_TASK\n1 immutable task I 'm on outbox event" as PROJECTION_TASK {
        unique outbox_event_uuid
        scope_kind / exact scope_key
        pending / leased / running / completed / failed / DLQ
        lease expiry / owner / fencing token
        attempts / next_retry_at
    }
    entity "PUBLIC_WS_EVENT_RECORD\nIt 's created atomically with a state;\ndispatchable After commit" as PUBLIC_EVENT
}

package "Record paths and background" as PATHS {
    class "Sending in sync API" as SEND
    class "Configure the background player\nYou can set the parallelism limit. = N\nname of the parameter is open" as WORKER_CONFIG
    class "Asynchronous pool of background performers\n0..N active slots\nThe execution model is open ." as WORKER_POOL
    class "The slot for the background 1" as SLOT_1
    class "The slot for the background 2" as SLOT_2
    class "The slot for the background ... N" as SLOT_N
    class "Exclusive ownership of the topic A\n(project_id, topic_uuid=A)" as TOPIC_CLAIM_A
    class "Exclusive ownership of the topic B\n(project_id, topic_uuid=B)" as TOPIC_CLAIM_B
    class "Follow-up on the topic A\n14:20 -> 14:19 -> 14:15\nMESSAGE.created_at DESC" as TOPIC_A_ORDER
    class "The reaction imager .\nOne exclusive owner" as REACTION_MATERIALIZER
    class "Rented shared scope\nmessage / user-stream / user-topic / user-folder\nexact key + fencing token" as SHARED_SCOPE_CLAIM
    class "I'm a dispatcher or a service person. WebSocket\nSend + repeat + play" as WS_DISPATCHER
}

