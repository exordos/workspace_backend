@startuml messenger_api_domain_model
!pragma layout smetana

title Target domain model Messenger API

hide methods
hide stereotypes
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}
skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    FontColor #0F172A
}
skinparam class {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    FontColor #1E3A8A
}
skinparam note {
    BackgroundColor #FFF7ED
    BorderColor #C2410C
