package "1. Current public routes\n(The contract is not changed .)" as ROUTES {
    class "/messages/ CRUD\nread/read_up_to/star/unstar" as R_MESSAGE
    class "/message_reactions/ CRUD" as R_REACTION
    class "/streams/ CRUD + actions" as R_STREAM
    class "/stream_bindings/ R/U/D" as R_STREAM_BINDING
    class "/stream_topics/ CRUD + actions" as R_TOPIC
    class "/folders/ CRUD\n/folder_items/ CRUD + pin/unpin" as R_FOLDER
    class "/users/ + /me/ + actions" as R_USER
    class "GET /server_settings\ntrailing slash The same middleware" as R_SERVER
}

package "2. It 's standard . RestAlchemy resource/controller" as RA {
    class "WorkspaceMessageController\nI 'm going to use the route adapter for placement UUID\nResourceByRAModel(WorkspaceUserMessage)" as C_MESSAGE
    class "WorkspaceMessageReactionController\nResourceByRAModel(WorkspaceMessageReactionView)\nWith a page ." as C_REACTION
    class "WorkspaceStreamController\nResourceByRAModel(WorkspaceUserStream)\nWith a page ." as C_STREAM
    class "WorkspaceStreamBindingController\nResourceByRAModel(WorkspaceStreamBindingView)\nWith a page ." as C_STREAM_BINDING
    class "WorkspaceStreamTopicController\nResourceByRAModel(WorkspaceUserTopic)\nWith a page ." as C_TOPIC
    class "WorkspaceFolderController\nResourceByRAModel(WorkspaceUserFolder)\nWith a page ." as C_FOLDER
    class "WorkspaceUserController / MeController\nResourceByRAModel(WorkspaceUser)\nPagination or direct access" as C_USER
    class "ServerSettingsMiddleware\nA direct answer .\nwithout a model RestAlchemy" as C_SERVER
}

package "3. Read patterns without calculations" as VIEWS {
    entity "messenger_api_user_messages_v1\nThe root: USER_MESSAGE_BINDING\nplacement.uuid -> public uuid\nbinding.uuid -> Hidden ORM-The key ." as V_MESSAGE
    entity "messenger_api_message_reactions_v1\nThe root: The raw fact of the reaction" as V_REACTION
    entity "messenger_api_user_streams_v1\nThe root: It 's a unique binding . user/stream" as V_STREAM
    entity "messenger_api_stream_bindings_v1\nThe root: the visible line-The adapter . binding" as V_STREAM_BINDING
    entity "messenger_api_user_topics_v1\nThe root: It 's a unique binding . user/topic" as V_TOPIC
    entity "messenger_api_user_folders_v1\nThe root: It 's a unique binding . user/folder" as V_FOLDER
}

package "4. Proposal: physical SQL-storable The essence" as PHYSICAL {
    entity "MESSAGE\nmessenger_messages" as MESSAGE {
        uuid : UUID <<PK, The internal canonical ID>>
        project_id
        author
        payload / source
        external_account_uuid / provider_external_id <<hidden>>
        provider / delivery
        reactions / reaction_users
        created_at / updated_at <<public>>
    }

    entity "MESSAGE_PLACEMENT\nmessenger_message_placements" as MESSAGE_PLACEMENT {
        uuid <<public UUIDv5 placement>>
        message_uuid <<FK>>
        stream / topic <<FK>>
        It 's unique .: project + message + stream + topic
    }

    entity "USER_MESSAGE_BINDING\nmessenger_user_message_bindings" as USER_MESSAGE_BINDING {
        uuid <<Hidden identity ORM-- What ?>>
        placement_uuid / user_uuid <<FK>>
        relation_role / visibility / permissions
        membership_generation snapshot
        It 's unique .: project + placement + user
        without revision
    }

    entity "USER_MESSAGE_STATE\nmessenger_user_message_states" as USER_MESSAGE_STATE {
        placement_uuid / user_uuid <<FK>>
        membership_generation <<snapshot>>
        read / mentioned / starred / pinned
        It 's unique .: project + user + placement
    }

    entity "MESSAGE_REACTION_FACT\nmessenger_message_reaction_facts\nIt 's unique .: project + message + user + emoji" as REACTION_FACT
    entity "STREAM\nmessenger_streams" as STREAM {
        owner_uuid <<indexed FK to user>>
        direct_user_uuid <<nullable - It 's indexed . FK I 'm on user>>
        private
    }
    entity "USER_STREAM_BINDING\nmessenger_stream_bindings" as STREAM_BINDING {
        user_uuid / stream_uuid <<It 's unique ., FK>>
        It 's unique .: project + user + stream
        role / notification
        active / membership_generation
        Unread counters / last_message_uuid
    }
    entity "TOPIC\nmessenger_topics" as TOPIC
    entity "USER_TOPIC_BINDING\nmessenger_user_topic_bindings" as TOPIC_BINDING {
        user_uuid / topic_uuid <<It 's unique ., FK>>
        It 's unique .: project + user + topic
        The flags / notification / Unread counters
    }
    entity "FOLDER\nmessenger_folders" as FOLDER
    entity "USER_FOLDER_BINDING\nmessenger_user_folder_bindings" as FOLDER_BINDING {
        user_uuid / folder_uuid <<It 's unique ., FK>>
        It 's unique .: project + user + folder
        rule / type
        unread_count / mention_count
        folder_items_snapshot : JSONB <<read-only>>
        snapshot_version / snapshot_updated_at <<internal>>
    }
    entity "FOLDER_ITEM\nmessenger_folder_items" as FOLDER_ITEM {
        user_uuid / folder_uuid / stream_uuid <<FK>>
        automatic
        It 's unique .: project + user + folder + stream
    }
    entity "USER\nmessenger_users" as USER
    entity "DOMAIN_OUTBOX_EVENT\nmessenger_domain_outbox_events\nIt 's unchanging ." as OUTBOX_EVENT
    entity "PROJECTION_TASK\nmessenger_projection_tasks\n1 immutable task I 'm on outbox event" as PROJECTION_TASK {
        unique outbox_event_uuid
        scope_kind / exact scope_key
        pending / leased / running / completed / failed / DLQ
        lease expiry / owner / fencing token
        attempts / next_retry_at
    }
    entity "SCOPE_LEASE\nmessenger_projection_scope_leases" as SCOPE_LEASE {
        unique project + scope_kind + scope_key
        lease owner / expiry / fencing token
    }
    entity "PUBLIC_EVENT_RECORD\nm_workspace_events\nIt 's formed atomically from state;\ndispatchable After commit" as PUBLIC_EVENT
}

package "5. The background material" as BACKGROUND {
    class "The slot worker Exclusive ownership exact scope\nReads the last state of the original" as WORKER
    class "I'm a dispatcher or a service person. WebSocket\nSend + repeat + play" as WS_DISPATCHER
}

