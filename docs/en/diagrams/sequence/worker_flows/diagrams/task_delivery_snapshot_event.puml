title Typed projection task: delivery_snapshot_event
hide footbox
skinparam backgroundColor white
skinparam shadowing false

database "The original condition exact resource scope" as SOURCE
database "Unchanged outbox" as OUTBOX
participant "Task projector" as PROJECTOR
