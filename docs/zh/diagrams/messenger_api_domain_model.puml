@startuml messenger_api_domain_model
!pragma layout smetana

title 域名模型 Messenger API

hide methods
hide stereotypes
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}
skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    FontColor #0F172A
}
skinparam class {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    FontColor #1E3A8A
}
skinparam note {
    BackgroundColor #FFF7ED
    BorderColor #C2410C
    FontColor #7C2D12
}

package "1. 公开的 RestAlchemy API\n(现行合同没有变更)" as API {
    class "WorkspaceUserMessage\nResourceByRAModel\n页面化控制器" as API_MESSAGE
    class "WorkspaceMessageReaction\nResourceByRAModel\n页面化控制器" as API_REACTION
    class "WorkspaceUserStream\nResourceByRAModel\n页面化控制器" as API_STREAM
    class "WorkspaceUserTopic\nResourceByRAModel\n页面化控制器" as API_TOPIC
    class "WorkspaceUserFolder\nResourceByRAModel\n页面化控制器" as API_FOLDER
    class "WorkspaceUser\nResourceByRAModel" as API_USER
}

package "2. 简单的 SQL-只有阅读形式的适配器" as VIEWS {
    entity "messenger_api_user_messages_v1" as VIEW_MESSAGE {
        placement.uuid AS uuid <<公开的 UUIDv5>>
        user_binding.uuid AS binding_uuid <<隐藏密钥 ORM>>
        message.uuid AS canonical_message_uuid <<隐藏的>>
        --
        连接访问 / 位置背景
        使用者状态标志
        信息的内容/作者/投影
        created_at/updated_at 信息
    }

    entity "messenger_api_user_streams_v1" as VIEW_STREAM {
        一个用户的唯一链接
        --
        一个正规流
        已准备的未读消息计数器
    }

    entity "messenger_api_user_topics_v1" as VIEW_TOPIC {
        一个唯一的用户链接
        --
        一个正规主题
        已准备的未读消息计数器
    }

    entity "messenger_api_user_folders_v1" as VIEW_FOLDER {
        一个唯一的用户链接到文件
        --
        一个正规文件
        准备好了 unread_count / mention_count
    }
}

package "3. 设计物理 SQL-实质性\n(未来的迁移)" as DOMAIN {
    entity "MESSAGE\nWorkspaceMessage\nmessenger_messages" as MESSAGE {
        uuid : UUID <<PK, 内部规范 ID>>
        project_id
        author_uuid
        payload
        source / provider / delivery
        provider_realm_uuid / provider_message_id <<hidden>>
        reactions / reaction_users
        created_at : 公开的时间标记
        updated_at : 公开的时间标记
    }

    entity "MESSAGE_PLACEMENT\nWorkspaceMessagePlacement\nmessenger_message_placements" as MESSAGE_PLACEMENT {
        uuid : UUID <<公开的 UUIDv5>>
        message_uuid : UUID <<FK>>
        stream_uuid
        topic_uuid
        独特的: 项目 + 消息 + 流 + 主题
    }

    entity "USER_MESSAGE_BINDING\nWorkspaceUserMessageBinding\nmessenger_user_message_bindings" as USER_MESSAGE_BINDING {
        binding_uuid : UUID <<隐藏密钥 ORM>>
        placement_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        relation_role
        visibility
        permissions
        membership_generation : int <<snapshot>>
        独特的: 项目 + 位置 + 用户
        --
        没有版本 revision
    }

    entity "USER_MESSAGE_STATE\nWorkspaceUserMessageState\nmessenger_user_message_states" as USER_MESSAGE_STATE {
        placement_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        membership_generation : int <<snapshot>>
        read / mentioned / starred / pinned
        独特的: 项目 + 用户 + 位置
    }

    entity "MESSAGE_REACTION_FACT\nWorkspaceMessageReactionFact" as REACTION_FACT {
        uuid : UUID <<PK>>
        project_id
        canonical_message_uuid : UUID <<规范性 FK>>
        user_uuid : UUID <<FK 反应作者>>
        emoji_name
        --
        独特的: 项目 + 消息 + 用户 + 表情符号
    }

    entity "WorkspaceUser\nmessenger_users" as USER {
        user_uuid : UUID <<PK>>
    }

    entity "WorkspaceStream\nmessenger_streams" as STREAM {
        stream_uuid : UUID <<PK>>
        owner_uuid : UUID <<已被索引 FK 用户>>
        direct_user_uuid : UUID <<允许 null FK 用户>>
        private
        is_archived
        流的正规字段
    }

    entity "WorkspaceStreamBinding\nmessenger_stream_bindings" as STREAM_BINDING {
        binding_uuid : UUID <<PK>>
        user_uuid : UUID <<FK>>
        stream_uuid : UUID <<FK>>
        role / 通知
        active / membership_generation
        未读消息计数器 / last_message_uuid
    }

    entity "WorkspaceStreamTopic\nmessenger_topics" as TOPIC {
        topic_uuid : UUID <<PK>>
        project_id
        stream_uuid : UUID <<FK>>
        常规主题字段
    }

    entity "USER_TOPIC_BINDING\nmessenger_user_topic_bindings" as TOPIC_BINDING {
        topic_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        旗 / 通知 / 未读消息计数器
        独特的: 项目 + 用户 + 主题
    }

    entity "FOLDER\nmessenger_folders" as FOLDER
    entity "USER_FOLDER_BINDING\nmessenger_user_folder_bindings" as FOLDER_BINDING {
        folder_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        rule / type
        unread_count / mention_count
        folder_items_snapshot : JSONB <<read-only>>
        snapshot_version / snapshot_updated_at <<internal>>
        独特的: 项目 + 用户 + 文件
    }

    entity "FOLDER_ITEM\nmessenger_folder_items" as FOLDER_ITEM {
        folder_uuid : UUID <<FK>>
        stream_uuid : UUID <<FK>>
        automatic
        独特的: 项目 + 用户 + 文件 + 流
    }

    entity "DOMAIN_OUTBOX_EVENT\n没有变化" as OUTBOX_EVENT
    entity "PROJECTION_TASK\n1 immutable task 在 outbox event" as PROJECTION_TASK {
        unique outbox_event_uuid
        scope_kind / exact scope_key
        pending / leased / running / completed / failed / DLQ
        lease expiry / owner / fencing token
        attempts / next_retry_at
    }
    entity "PUBLIC_WS_EVENT_RECORD\n原子的状态;\ndispatchable 在之后 commit" as PUBLIC_EVENT
}

package "记录路径和背景处理" as PATHS {
    class "同步发送 API" as SEND
    class "背景演奏器配置\n可自定义的并行性限制 = N\n参数名字已开放" as WORKER_CONFIG
    class "背景表演者异步池\n0..N 活跃的插槽\n执行模型开放" as WORKER_POOL
    class "背景演奏器槽 1" as SLOT_1
    class "背景演奏器槽 2" as SLOT_2
    class "背景演奏器槽 ... N" as SLOT_N
    class "专属主题所有权 A\n(project_id, topic_uuid=A)" as TOPIC_CLAIM_A
    class "专属主题所有权 B\n(project_id, topic_uuid=B)" as TOPIC_CLAIM_B
    class "连续处理主题 A\n14:20 -> 14:19 -> 14:15\nMESSAGE.created_at DESC" as TOPIC_A_ORDER
    class "反应图像实质化器\n一个独家所有者" as REACTION_MATERIALIZER
    class "租 shared scope\nmessage / user-stream / user-topic / user-folder\nexact key + fencing token" as SHARED_SCOPE_CLAIM
    class "服务管理员 WebSocket\n发送 + 重复 + 播放" as WS_DISPATCHER
}

note top of MESSAGE
  目标句子: WorkspaceMessage / messenger_messages.
  其他目标分区表:
  messenger_message_placements, messenger_user_message_bindings,
  messenger_user_message_states.
  这些实体名称仅适用于未来的迁移..
end note

API_MESSAGE --> VIEW_MESSAGE : 标准的 objects / filters
API_REACTION --> REACTION_FACT : 创建/更新/删除一个事实
API_STREAM --> VIEW_STREAM : 标准的 objects / filters
API_TOPIC --> VIEW_TOPIC : 标准的 objects / filters
API_FOLDER --> VIEW_FOLDER : 标准的 objects / filters
API_USER --> USER : 直接标准资源

VIEW_MESSAGE --> USER_MESSAGE_BINDING : "根: 这就是 1 结合"
VIEW_MESSAGE --> MESSAGE_PLACEMENT : "索引连接许多-其他-一个"
VIEW_MESSAGE --> USER_MESSAGE_STATE : "索引连接一个-其他-一个\n用户 + 位置"
VIEW_MESSAGE --> MESSAGE : "已被索引 LEFT JOIN\n许多-其他-一个"
VIEW_STREAM --> STREAM_BINDING : "根: 这就是 1 绑定用户"
VIEW_STREAM --> STREAM : "索引连接\n许多-其他-一个"
VIEW_TOPIC --> TOPIC_BINDING : "根: 这就是 1 绑定用户"
VIEW_TOPIC --> TOPIC : "索引连接\n许多-其他-一个"
VIEW_FOLDER --> FOLDER_BINDING : "根: 这就是 1 绑定用户"
VIEW_FOLDER --> FOLDER : "索引连接\n许多-其他-一个"

MESSAGE ||--o{ MESSAGE_PLACEMENT : "显而易见的位置"
MESSAGE ||--o{ REACTION_FACT : "一个正规消息\n反应的初始事实"
USER ||--o{ REACTION_FACT : 反应作者
MESSAGE_PLACEMENT ||--o{ USER_MESSAGE_BINDING : 接收者访问
USER ||--o{ USER_MESSAGE_BINDING : "唯一的位置"
MESSAGE_PLACEMENT ||--o{ USER_MESSAGE_STATE : "用户/位置状态"
USER ||--o{ USER_MESSAGE_STATE
STREAM ||--o{ MESSAGE_PLACEMENT : 地方
TOPIC ||--o{ MESSAGE_PLACEMENT : "必须 namespace UUIDv5"

USER ||--o{ STREAM_BINDING
STREAM ||--o{ STREAM_BINDING
USER ||--o{ TOPIC_BINDING
TOPIC ||--o{ TOPIC_BINDING
USER ||--o{ FOLDER_BINDING
FOLDER ||--o{ FOLDER_BINDING
STREAM ||--o{ TOPIC

SEND --> MESSAGE : "时间同步: 创建 1"
SEND --> MESSAGE_PLACEMENT : "时间同步: 创建 1 位置"
SEND --> USER_MESSAGE_BINDING : "时间同步: 1 作者链接"
SEND --> USER_MESSAGE_STATE : "时间同步: 1 作者情况"
SEND --> OUTBOX_EVENT : "在同一交易中"
OUTBOX_EVENT --> PROJECTION_TASK : "这就是 1 immutable task 在 event"
WORKER_CONFIG --> WORKER_POOL : "活动的最多插槽 = N"
WORKER_POOL --> SLOT_1
WORKER_POOL --> SLOT_2
WORKER_POOL --> SLOT_N
SLOT_1 --> TOPIC_CLAIM_A : "专属动态捕获"
SLOT_2 --> TOPIC_CLAIM_B : "专属动态捕获"
TOPIC_CLAIM_A --> TOPIC_A_ORDER : "在主题内连续"
TOPIC_A_ORDER ..> MESSAGE : "选择常规消息"
TOPIC_CLAIM_B ..> MESSAGE : "选择一个主题 B\nMESSAGE.created_at DESC"
PROJECTION_TASK ..> TOPIC_CLAIM_A : "显而易见的位置; 没有扫描"
TOPIC_A_ORDER ..> USER_MESSAGE_BINDING : "接收者异步连接 0..*\n每一个位置"
TOPIC_CLAIM_B ..> USER_MESSAGE_BINDING : "接收者异步连接 0..*\n每一个位置"
TOPIC_A_ORDER ..> USER_MESSAGE_STATE : "创建/确保收件人的状态\n带着带"
TOPIC_CLAIM_B ..> USER_MESSAGE_STATE : "创建/确保收件人的状态\n带着带"
PROJECTION_TASK ..> SHARED_SCOPE_CLAIM : "实际路线 scope"
SHARED_SCOPE_CLAIM ..> REACTION_MATERIALIZER : "scope=message"
REACTION_FACT --> REACTION_MATERIALIZER : "阅读信息的事实"
REACTION_MATERIALIZER --> MESSAGE : "记录 reactions + reaction_users"
REACTION_MATERIALIZER --> PUBLIC_EVENT : "在一个 DB transaction 没有 materialized state"
PUBLIC_EVENT --> WS_DISPATCHER : 已准备的记录
SHARED_SCOPE_CLAIM ..> STREAM_BINDING : "user-stream: 计数器/资产情况"
SHARED_SCOPE_CLAIM ..> TOPIC_BINDING : "user-topic: 计数器/资产情况"
SHARED_SCOPE_CLAIM ..> FOLDER_BINDING : "user-folder: unread_count"
SHARED_SCOPE_CLAIM ..> FOLDER_ITEM : "user-folder: automatic projection"

note right of FOLDER_BINDING
  FOLDER_ITEM rows remain normalized source of truth.
  folder_projection exact user-folder scope atomically writes
  deterministic folder_items_snapshot + ready counts + version/time
  + all ready event rows. Dispatcher reads only after commit.
  Public folder_items maps directly from snapshot; empty = [].
end note

note bottom of VIEW_MESSAGE
  一个用户绑定 -> 一个位置 -> 一条消息/状态.
  公开的 uuid 来自 MESSAGE_PLACEMENT.
  get_id_property 可以使用隐藏 binding_uuid
  只是作为一个独特的技术 ORM-字符串键.
  MESSAGE.uuid 隐藏为正规 FK 内容.
  binding_uuid 不属于当前的公开 JSON.
  适配器/路由使用 MESSAGE_PLACEMENT.uuid.
  不同的位置有不同的公共 uuid.
  公众活动 created_at/updated_at 它们来自 MESSAGE.
  is_own — 连接的标识符的尺度比较.
  没有组件, GROUP BY, 侧面/窗口表达,
  相关的小需求或风波传播 一个-其他-许多人.
end note

note top of MESSAGE_PLACEMENT
  uuid = UUIDv5(namespace = TOPIC.uuid,
                name = MESSAGE.uuid).
  Name — lowercase hyphenated canonical UUID.
  Name 没有 project/stream, braces 或是前.
  TOPIC 具有约束力,全球性,独特性和不变性
  属于一个人. STREAM/PROJECT.
  Business key 其他 FK 保持权威性.
end note

note bottom of VIEW_STREAM
  公众活动 UUID-标的链接 UUID-属性,
  而不是 URI 关系 RestAlchemy.
  物理列 *_uuid 仍然是索引 FK
  显然是引用的行为.
  owner_uuid 作为一个公开字段 owner 没有 UUID.
end note

note bottom of FOLDER_BINDING
  流/主题/文件的集合存储在一个独特的绑定
  同一个用户/容器区域.
  单个消息的绑定不会被容器计数器保存.
  更新是最终的,并得到了一致.;
  只有背景进行重建/重建.
  系统连接具有固定的 rule/type;
  自动 FOLDER_ITEM 背景表演者.
  来源: 活跃的 USER_STREAM_BINDING 其他 STREAM.is_archived = false.
  All chats: 所有的; Personal: private = true; Channels: private = false.
end note

note bottom of REACTION_MATERIALIZER
  API 改变一个原始事实行.
  API 永远不会执行循环 «阅读 变更 记录» 照片.
  事实 真理的来源; 图片可以重组.
  这两张照片都是由一个人拍摄的. fenced owner scope=message.
  Topic lock 为了 canonical snapshot 没有使用.
end note

note bottom of PROJECTION_TASK
  任务类型: fanout; content_mentions; reaction_snapshot;
  read_counters; delivery_snapshot_event;
  topic_membership_policy_rebuild; topic_state_projection;
  folder_projection.
  Initial design: 没有 coalescing.
  Unique outbox_event_uuid; retry derivation = no-op.
  Lease expiry + fencing; retry/backoff; max attempts/DLQ;
  reaper/reconciliation; idempotent handler.
  Routing: topic 只有 placements/bindings;
  message 为了 snapshots; user-stream/user-topic/user-folder 为了 aggregates.
  Shared scope 没有 fallback 在 topic.
  Atomic delta 要求 exactly-once guard 根据 outbox_event_uuid;
  否则 scope worker recomputes/writes.
end note

note bottom of STREAM_BINDING
  Persistent lifecycle row.
  Revoke: active=false + generation++ 时间同步.
  Re-add: fresh generation; stale fanout/history no-op.
  Message/reaction read 要求 active + generation equality.
end note

note bottom of SEND
  作者和其联系 USER_MESSAGE_STATE 它们是同步创建的.
  没有向收件人传输.
  没有重算组件.
  无法更改的事件 (outbox) 进入交易.
  GET/列表操作不会创建任务.
  作者可以立即查看消息.
end note

note bottom of STREAM
  如果 direct_user_uuid 已设置, private = true.
  direct_user_uuid, 它们是同等的 UUID 现在的 owner, 意思是和自己聊天:
  一个子 owner, 一个可见的参与者.
  通过向收件者传递不会增加用户绑定,
  所以,正规的消息只能看到一次..
end note

note bottom of WS_DISPATCHER
  后台表演者没有网络连接.
  控制器发送,重复和播放已准备的事件.
end note

note bottom of TOPIC_CLAIM_A
  不同主题可以同时处理.
  一个人 (project_id, topic_uuid) 不超过一个槽.
  在每一个被捕获的主题中,先选择新的主题.:
  MESSAGE.created_at DESC.
  举例: 14:20 -> 14:19 -> 14:15.
  任务和绑定的时间标记不确定顺序.
  其他键/指针保持开放.
  接收者可能会有大约一秒的延迟..
  这最终是计划上的一致性..
  时间 «首先是新品» 不应该导致老消息的饥饿;
  限制性正义在主题的捕获范围内发挥作用.
  捕获/释放/重新捕获的机制仍然是开放的.
  没有隐性备份部分.
end note

@enduml
