@startuml
!pragma layout smetana
skinparam shadowing false
title POST /api/workspace/v1/users/{user_uuid}/actions/avatar_reset/invoke
actor "Клиент" as Client
participant "Контроллер RestAlchemy" as API
database "Настроенное файловое хранилище" as STORE
database "Пользователь Workspace в PostgreSQL" as DB
queue "Транзакционный outbox" as OUT
queue "delivery_snapshot_event\nexact user scope" as TASK
participant "Пул воркеров" as WORKER
database "Хранилище публичных событий" as EVENT
participant "Диспетчер WebSocket" as DISP
participant "Клиенты Workspace" as WS
Client -> API: POST {}
API -> DB: BEGIN; проверить/заблокировать собственного пользователя
API -> DB: установить канонический URN Gravatar или резервный вариант
API -> OUT: добавить сброс аватара
API -> DB: COMMIT
API --> Client: 200 JSON пользователя
API -> STORE: удалить заменённый пользовательский аватар
OUT -> TASK: immutable delivery_snapshot_event(outbox_event_uuid)
TASK -> WORKER: прочитать последнего пользователя
WORKER -> EVENT: вставить готовое user.updated
DISP -> EVENT: отправлять/повторять/воспроизводить
DISP -> WS: user.updated
@enduml
