@startuml messenger_api_domain_model
!pragma layout smetana

title Projekt-Domainmodell Messenger API

hide methods
hide stereotypes
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}
skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    FontColor #0F172A
}
skinparam class {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    FontColor #1E3A8A
}
skinparam note {
    BackgroundColor #FFF7ED
    BorderColor #C2410C
    FontColor #7C2D12
}

package "1. Öffentlich RestAlchemy API\n(Der gültige Vertrag ist unverändert)" as API {
    class "WorkspaceUserMessage\nResourceByRAModel\nController mit Pagination" as API_MESSAGE
    class "WorkspaceMessageReaction\nResourceByRAModel\nController mit Pagination" as API_REACTION
    class "WorkspaceUserStream\nResourceByRAModel\nController mit Pagination" as API_STREAM
    class "WorkspaceUserTopic\nResourceByRAModel\nController mit Pagination" as API_TOPIC
    class "WorkspaceUserFolder\nResourceByRAModel\nController mit Pagination" as API_FOLDER
    class "WorkspaceUser\nResourceByRAModel" as API_USER
}

package "2. Einfache SQL-nur für Lesen geeignete Formadapter" as VIEWS {
    entity "messenger_api_user_messages_v1" as VIEW_MESSAGE {
        placement.uuid AS uuid <<öffentlich UUIDv5>>
        user_binding.uuid AS binding_uuid <<versteckter Schlüssel ORM>>
        message.uuid AS canonical_message_uuid <<Verborgen>>
        --
        Zugriff auf das Verknüpfen / Kontext der Platzierung
        Benutzerstatus-Flaggen
        Inhalt/Autor/Projektion der Nachricht
        created_at/updated_at Nachrichten
    }

    entity "messenger_api_user_streams_v1" as VIEW_STREAM {
        Ein einzigartiges Nutzer-Bindungssystem für den Stream
        --
        ein kanonischer Stream
        Bereite Nachrichtenzählgeräte
    }

    entity "messenger_api_user_topics_v1" as VIEW_TOPIC {
        Ein einzigartiges Benutzerverbindungsthema
        --
        Ein kanonisches Thema
        Bereite Nachrichtenzählgeräte
    }

    entity "messenger_api_user_folders_v1" as VIEW_FOLDER {
        ein einzigartiges Benutzerverbindungspaket
        --
        ein Ordner
        - Bereit unread_count / mention_count
    }
}

package "3. Projekte physikalische SQL-- und\n(zukünftige Migration)" as DOMAIN {
    entity "MESSAGE\nWorkspaceMessage\nmessenger_messages" as MESSAGE {
        uuid : UUID <<PK, Innenkanon ID>>
        project_id
        author_uuid
        payload
        source / provider / delivery
        provider_realm_uuid / provider_message_id <<hidden>>
        reactions / reaction_users
        created_at : öffentliche Zeitmarkierung
        updated_at : öffentliche Zeitmarkierung
    }

    entity "MESSAGE_PLACEMENT\nWorkspaceMessagePlacement\nmessenger_message_placements" as MESSAGE_PLACEMENT {
        uuid : UUID <<öffentlich UUIDv5>>
        message_uuid : UUID <<FK>>
        stream_uuid
        topic_uuid
        Einzigartig: Projekt + Nachricht + Stream + Thema
    }

    entity "USER_MESSAGE_BINDING\nWorkspaceUserMessageBinding\nmessenger_user_message_bindings" as USER_MESSAGE_BINDING {
        binding_uuid : UUID <<versteckter Schlüssel ORM>>
        placement_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        relation_role
        visibility
        permissions
        membership_generation : int <<snapshot>>
        Einzigartig: Projekt + Platzierung + Nutzer
        --
        ohne Version revision
    }

    entity "USER_MESSAGE_STATE\nWorkspaceUserMessageState\nmessenger_user_message_states" as USER_MESSAGE_STATE {
        placement_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        membership_generation : int <<snapshot>>
        read / mentioned / starred / pinned
        Einzigartig: Projekt + Benutzer + Platzierung
    }

    entity "MESSAGE_REACTION_FACT\nWorkspaceMessageReactionFact" as REACTION_FACT {
        uuid : UUID <<PK>>
        project_id
        canonical_message_uuid : UUID <<Kanonisch FK>>
        user_uuid : UUID <<FK Der Autor der Reaktion>>
        emoji_name
        --
        Einzigartig: Projekt + Nachricht + Benutzer + Emoji
    }

    entity "WorkspaceUser\nmessenger_users" as USER {
        user_uuid : UUID <<PK>>
    }

    entity "WorkspaceStream\nmessenger_streams" as STREAM {
        stream_uuid : UUID <<PK>>
        owner_uuid : UUID <<- und nicht FK Benutzer>>
        direct_user_uuid : UUID <<Einlässigkeit null FK Benutzer>>
        private
        is_archived
        Kanonische Felder des Stroms
    }

    entity "WorkspaceStreamBinding\nmessenger_stream_bindings" as STREAM_BINDING {
        binding_uuid : UUID <<PK>>
        user_uuid : UUID <<FK>>
        stream_uuid : UUID <<FK>>
        role / Nachricht
        active / membership_generation
        Nichtgelesenen Nachrichten-Zähler / last_message_uuid
    }

    entity "WorkspaceStreamTopic\nmessenger_topics" as TOPIC {
        topic_uuid : UUID <<PK>>
        project_id
        stream_uuid : UUID <<FK>>
        Kanonische Themenfelder
    }

    entity "USER_TOPIC_BINDING\nmessenger_user_topic_bindings" as TOPIC_BINDING {
        topic_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        Flaggen / Benachrichtigungen / Nichtgelesenen-Meldungs-Zählgeräte
        Einzigartig: Projekt + Benutzer + Thema
    }

    entity "FOLDER\nmessenger_folders" as FOLDER
    entity "USER_FOLDER_BINDING\nmessenger_user_folder_bindings" as FOLDER_BINDING {
        folder_uuid : UUID <<FK>>
        user_uuid : UUID <<FK>>
        rule / type
        unread_count / mention_count
        folder_items_snapshot : JSONB <<read-only>>
        snapshot_version / snapshot_updated_at <<internal>>
        Einzigartig: Projekt + Benutzer + Ordner
    }

    entity "FOLDER_ITEM\nmessenger_folder_items" as FOLDER_ITEM {
        folder_uuid : UUID <<FK>>
        stream_uuid : UUID <<FK>>
        automatic
        Einzigartig: Projekt + Benutzer + Ordner + Stream
    }

    entity "DOMAIN_OUTBOX_EVENT\n- Das ist nicht veränderlich." as OUTBOX_EVENT
    entity "PROJECTION_TASK\n1 immutable task - Auf outbox event" as PROJECTION_TASK {
        unique outbox_event_uuid
        scope_kind / exact scope_key
        pending / leased / running / completed / failed / DLQ
        lease expiry / owner / fencing token
        attempts / next_retry_at
    }
    entity "PUBLIC_WS_EVENT_RECORD\nwird atomar mit dem Zustand erzeugt;\ndispatchable Nachher commit" as PUBLIC_EVENT
}

package "Aufzeichnungswege und Hintergrundverarbeitung" as PATHS {
    class "Synchronisiert verschicken API" as SEND
    class "Einstellung des Hintergrundspielers\nangepasste Parallelisierungsbeschränkung = N\nName der Parameter ist offen" as WORKER_CONFIG
    class "Asynchroner Pool von Hintergrundspielern\n0..N Aktives Slot\nAusführung ist offen" as WORKER_POOL
    class "Hintergrund-Slot 1" as SLOT_1
    class "Hintergrund-Slot 2" as SLOT_2
    class "Hintergrund-Slot ... N" as SLOT_N
    class "Besitz des Themas A\n(project_id, topic_uuid=A)" as TOPIC_CLAIM_A
    class "Besitz des Themas B\n(project_id, topic_uuid=B)" as TOPIC_CLAIM_B
    class "Folgeverarbeitung A\n14:20 -> 14:19 -> 14:15\nMESSAGE.created_at DESC" as TOPIC_A_ORDER
    class "Reaktionsbildmaterialisierer\nEin exklusiver Eigentümer" as REACTION_MATERIALIZER
    class "Miete shared scope\nmessage / user-stream / user-topic / user-folder\nexact key + fencing token" as SHARED_SCOPE_CLAIM
    class "- Ein Dispatcher. WebSocket\nVersenden + Wiederholen + Wiederholen" as WS_DISPATCHER
}

note top of MESSAGE
  Zielsatz: WorkspaceMessage / messenger_messages.
  Weitere Ziel-Teilungs-Tabellen:
  messenger_message_placements, messenger_user_message_bindings,
  messenger_user_message_states.
  Diese physischen Namen beziehen sich nur auf die zukünftige Migration..
end note

API_MESSAGE --> VIEW_MESSAGE : Standard-Systeme objects / filters
API_REACTION --> REACTION_FACT : Erstellen / Aktualisieren / Löschen eines Fakts
API_STREAM --> VIEW_STREAM : Standard-Systeme objects / filters
API_TOPIC --> VIEW_TOPIC : Standard-Systeme objects / filters
API_FOLDER --> VIEW_FOLDER : Standard-Systeme objects / filters
API_USER --> USER : Direkt-Standardressource

VIEW_MESSAGE --> USER_MESSAGE_BINDING : "Wurzeln: - Genau so. 1 - Das ist ein Schlüssel."
VIEW_MESSAGE --> MESSAGE_PLACEMENT : "Indexverbindung viele-- und-Einer"
VIEW_MESSAGE --> USER_MESSAGE_STATE : "Indexverbindung eins-- und-Einer\nBenutzer + Platzierung"
VIEW_MESSAGE --> MESSAGE : "- und nicht LEFT JOIN\n- Viele .-- und-Einer"
VIEW_STREAM --> STREAM_BINDING : "Wurzeln: - Genau so. 1 Benutzerbindung"
VIEW_STREAM --> STREAM : "Indexverbindung\n- Viele .-- und-Einer"
VIEW_TOPIC --> TOPIC_BINDING : "Wurzeln: - Genau so. 1 Benutzerbindung"
VIEW_TOPIC --> TOPIC : "Indexverbindung\n- Viele .-- und-Einer"
VIEW_FOLDER --> FOLDER_BINDING : "Wurzeln: - Genau so. 1 Benutzerbindung"
VIEW_FOLDER --> FOLDER : "Indexverbindung\n- Viele .-- und-Einer"

MESSAGE ||--o{ MESSAGE_PLACEMENT : "offensichtliche Platzierungen"
MESSAGE ||--o{ REACTION_FACT : "ein Kanonische Nachricht\nReaktionsbeginn"
USER ||--o{ REACTION_FACT : Reaktionsschreiber
MESSAGE_PLACEMENT ||--o{ USER_MESSAGE_BINDING : Zugang des Empfängers
USER ||--o{ USER_MESSAGE_BINDING : "Einzigartig für die Platzierung"
MESSAGE_PLACEMENT ||--o{ USER_MESSAGE_STATE : "Status des Benutzers/der Unterkunft"
USER ||--o{ USER_MESSAGE_STATE
STREAM ||--o{ MESSAGE_PLACEMENT : - die
TOPIC ||--o{ MESSAGE_PLACEMENT : "- die namespace UUIDv5"

USER ||--o{ STREAM_BINDING
STREAM ||--o{ STREAM_BINDING
USER ||--o{ TOPIC_BINDING
TOPIC ||--o{ TOPIC_BINDING
USER ||--o{ FOLDER_BINDING
FOLDER ||--o{ FOLDER_BINDING
STREAM ||--o{ TOPIC

SEND --> MESSAGE : "synchron: Erstellen 1"
SEND --> MESSAGE_PLACEMENT : "synchron: Erstellen 1 - die Platzierung"
SEND --> USER_MESSAGE_BINDING : "synchron: 1 Verfasserin"
SEND --> USER_MESSAGE_STATE : "synchron: 1 Der Zustand des Autors"
SEND --> OUTBOX_EVENT : "in derselben Transaktion"
OUTBOX_EVENT --> PROJECTION_TASK : "- Genau so. 1 immutable task - Auf event"
WORKER_CONFIG --> WORKER_POOL : "Maximaler Anzahl an aktiven Slots = N"
WORKER_POOL --> SLOT_1
WORKER_POOL --> SLOT_2
WORKER_POOL --> SLOT_N
SLOT_1 --> TOPIC_CLAIM_A : "Exklusive dynamische Erfassung"
SLOT_2 --> TOPIC_CLAIM_B : "Exklusive dynamische Erfassung"
TOPIC_CLAIM_A --> TOPIC_A_ORDER : "Folgen innerhalb des Themas"
TOPIC_A_ORDER ..> MESSAGE : "die Kanonische Nachricht auswählen"
TOPIC_CLAIM_B ..> MESSAGE : "Auswahl des Themas B\nMESSAGE.created_at DESC"
PROJECTION_TASK ..> TOPIC_CLAIM_A : "offensichtliche Platzierungsfläche; ohne Scan"
TOPIC_A_ORDER ..> USER_MESSAGE_BINDING : "Asynchrone Verbindung der Empfänger 0..*\nfür jede Platzierung"
TOPIC_CLAIM_B ..> USER_MESSAGE_BINDING : "Asynchrone Verbindung der Empfänger 0..*\nfür jede Platzierung"
TOPIC_A_ORDER ..> USER_MESSAGE_STATE : "den Empfängerzustand erstellen/versorgen\nzusammen mit der Verbindung"
TOPIC_CLAIM_B ..> USER_MESSAGE_STATE : "den Empfängerzustand erstellen/versorgen\nzusammen mit der Verbindung"
PROJECTION_TASK ..> SHARED_SCOPE_CLAIM : "Routen nach der tatsächlichen scope"
SHARED_SCOPE_CLAIM ..> REACTION_MATERIALIZER : "scope=message"
REACTION_FACT --> REACTION_MATERIALIZER : "Die Fakten für die Nachricht lesen"
REACTION_MATERIALIZER --> MESSAGE : "Aufschreiben reactions + reaction_users"
REACTION_MATERIALIZER --> PUBLIC_EVENT : "in einer DB transaction mit materialized state"
PUBLIC_EVENT --> WS_DISPATCHER : Bereite Aufzeichnungen
SHARED_SCOPE_CLAIM ..> STREAM_BINDING : "user-stream: Zähler/Zustand"
SHARED_SCOPE_CLAIM ..> TOPIC_BINDING : "user-topic: Zähler/Zustand"
SHARED_SCOPE_CLAIM ..> FOLDER_BINDING : "user-folder: unread_count"
SHARED_SCOPE_CLAIM ..> FOLDER_ITEM : "user-folder: automatic projection"

note right of FOLDER_BINDING
  FOLDER_ITEM rows remain normalized source of truth.
  folder_projection exact user-folder scope atomically writes
  deterministic folder_items_snapshot + ready counts + version/time
  + all ready event rows. Dispatcher reads only after commit.
  Public folder_items maps directly from snapshot; empty = [].
end note

note bottom of VIEW_MESSAGE
  Ein benutzerdefiniertes Bindungsfeld -> Ein Platz -> ein Status.
  Öffentlich uuid kommt aus MESSAGE_PLACEMENT.
  get_id_property kann den versteckten binding_uuid
  Nur als einzigartige technische ORM-Zeilen-Schlüssel.
  MESSAGE.uuid als kanonisch versteckt FK Inhalt.
  binding_uuid nicht in die aktuelle öffentliche JSON.
  Adapter/Route verwendet MESSAGE_PLACEMENT.uuid.
  Verschiedene Platzierungen haben verschiedene öffentliche uuid.
  Öffentliche created_at/updated_at Sie kommen aus MESSAGE.
  is_own — Skalierung der verbundenen Identifikatoren.
  Keine Geräte, GROUP BY, Seitenausdrücke/Fenster-Ausdrücke,
  Korrelatierte Unteranfragen oder Windverbreitung eins-- Das ist ...-- Für viele..
end note

note top of MESSAGE_PLACEMENT
  uuid = UUIDv5(namespace = TOPIC.uuid,
                name = MESSAGE.uuid).
  Name — lowercase hyphenated canonical UUID.
  Name enthält keine project/stream, braces oder Vorlagen.
  TOPIC verbindlich, global einzigartig und unveränderlich
  Gehört genau einem STREAM/PROJECT.
  Business key und Komponenten FK Sie bleiben einflussreich.
end note

note bottom of VIEW_STREAM
  Öffentliche UUID-Verweise  Skalier UUID-Eigenschaften,
  Nein. URI Beziehungen RestAlchemy.
  Physische Spalten *_uuid bleiben indexiert FK
  mit offensichtlichen Verweisungen.
  owner_uuid wird als öffentliches Feld ausgeführt owner mit UUID.
end note

note bottom of FOLDER_BINDING
  Die Strömung/Theme/Ordner werden in einem einzigartigen Link gespeichert
  derselben Nutzer/Container-Bereich.
  Die Bindungen von einzelnen Nachrichten werden nicht von den Containerzählern gespeichert.
  Die Updates sind impotent und schließlich abgestimmt;
  Wiederherstellung/Umbau erfolgt nur im Hintergrund.
  Die Systembindungen haben feststehende rule/type;
  automatisch FOLDER_ITEM Der Hintergrund-Aussteller wird realisiert.
  Quelle: Aktiv USER_STREAM_BINDING und STREAM.is_archived = false.
  All chats: - Das ist alles.; Personal: private = true; Channels: private = false.
end note

note bottom of REACTION_MATERIALIZER
  API ändert genau eine ursprüngliche Zeile der Tatsache.
  API nie einen Zyklus ausführt «Lesen  Ändern  Aufzeichnen» Bilder.
  Die Fakten  die Quelle der Wahrheit; Die Bilder können umgebaut werden..
  Beide Bilder sind von nur einem geschrieben. fenced owner scope=message.
  Topic lock für canonical snapshot nicht verwendet.
end note

note bottom of PROJECTION_TASK
  Aufgabenarten: fanout; content_mentions; reaction_snapshot;
  read_counters; delivery_snapshot_event;
  topic_membership_policy_rebuild; topic_state_projection;
  folder_projection.
  Initial design: Ohne coalescing.
  Unique outbox_event_uuid; retry derivation = no-op.
  Lease expiry + fencing; retry/backoff; max attempts/DLQ;
  reaper/reconciliation; idempotent handler.
  Routing: topic Nur für placements/bindings;
  message für snapshots; user-stream/user-topic/user-folder für aggregates.
  Shared scope hat keine fallback - Auf topic.
  Atomic delta Erfordert exactly-once guard Nach outbox_event_uuid;
  - Nein, sonst nicht. scope worker recomputes/writes.
end note

note bottom of STREAM_BINDING
  Persistent lifecycle row.
  Revoke: active=false + generation++ synchron.
  Re-add: fresh generation; stale fanout/history no-op.
  Message/reaction read Erfordert active + generation equality.
end note

note bottom of SEND
  Verknüpfung des Autors und seiner USER_MESSAGE_STATE Synchron erstellt werden.
  Keine Ventilatorverbreitung an Empfänger.
  Keine Umzählung der Aggregate.
  Nicht veränderbares Ereignis des Ausgangsevent-Journals (outbox) wird in die Transaktion aufgenommen.
  GET/Die Liste wird nicht mehr ausgeführt.
  Der Autor sieht die Nachricht sofort.
end note

note bottom of STREAM
  Wenn direct_user_uuid - Das ist es., private = true.
  direct_user_uuid, gleich UUID - der laufenden owner, bedeutet, mit sich selbst zu chatten.:
  Ein Bindung owner, Ein sichtbarer Teilnehmer.
  Durch die Vernetzung werden keine Benutzerbindungen hinzugefügt,
  Also kann man die Kanonische Nachricht nur einmal sehen..
end note

note bottom of WS_DISPATCHER
  Der Hintergrund-Aussteller besitzt keine Netzwerkverbindungen.
  Der Controller sendet, wiederholt und spielt vorbereitete Ereignisse.
end note

note bottom of TOPIC_CLAIM_A
  Verschiedene Themen können parallel behandelt werden.
  Einer (project_id, topic_uuid) nicht mehr als ein Slot.
  Innerhalb jedes erfassten Themas werden zuerst neue Themen ausgewählt.:
  MESSAGE.created_at DESC.
  Beispiel: 14:20 -> 14:19 -> 14:15.
  Die Zeichnungen der Aufgaben und der Verknüpfungen definieren nicht die Reihenfolge.
  Der zusätzliche Schlüssel/Kursor für gleichartige Markierungen bleibt offen.
  Die Sicht für den Empfänger kann etwa eine Sekunde verzögert sein..
  Es ist eine geplante Übereinstimmung am Ende..
  Die Reihenfolge «Erst die Neuen.» Es sollte nicht dazu führen , dass alte Nachrichten hungern;
  Die begrenzte Gerechtigkeit ist im Rahmen der Erfassung des Themas.
  Der Mechanismus der Gefangennahme/Befreiung/Wiedergefangennahme bleibt offen..
  Keine stillschweigende Sicherung.
end note

@enduml
