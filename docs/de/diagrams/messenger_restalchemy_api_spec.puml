@startuml messenger_restalchemy_api_spec
!pragma layout smetana

title Projektspezifikation Messenger RestAlchemy API

hide methods
hide stereotypes
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}
skinparam class {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    FontColor #1E3A8A
}
skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    FontColor #0F172A
}
skinparam note {
    BackgroundColor #FFF7ED
    BorderColor #C2410C
    FontColor #7C2D12
}

package "1. Geltende öffentliche Routen\n(Der Vertrag ändert sich nicht.)" as ROUTES {
    class "/messages/ CRUD\nread/read_up_to/star/unstar" as R_MESSAGE
    class "/message_reactions/ CRUD" as R_REACTION
    class "/streams/ CRUD + actions" as R_STREAM
    class "/stream_bindings/ R/U/D" as R_STREAM_BINDING
    class "/stream_topics/ CRUD + actions" as R_TOPIC
    class "/folders/ CRUD\n/folder_items/ CRUD + pin/unpin" as R_FOLDER
    class "/users/ + /me/ + actions" as R_USER
    class "GET /server_settings\ntrailing slash wird mit middleware" as R_SERVER
}

package "2. Standard RestAlchemy resource/controller" as RA {
    class "WorkspaceMessageController\nWegadapter für placement UUID\nResourceByRAModel(WorkspaceUserMessage)" as C_MESSAGE
    class "WorkspaceMessageReactionController\nResourceByRAModel(WorkspaceMessageReactionView)\nmit Pagina" as C_REACTION
    class "WorkspaceStreamController\nResourceByRAModel(WorkspaceUserStream)\nmit Pagina" as C_STREAM
    class "WorkspaceStreamBindingController\nResourceByRAModel(WorkspaceStreamBindingView)\nmit Pagina" as C_STREAM_BINDING
    class "WorkspaceStreamTopicController\nResourceByRAModel(WorkspaceUserTopic)\nmit Pagina" as C_TOPIC
    class "WorkspaceFolderController\nResourceByRAModel(WorkspaceUserFolder)\nmit Pagina" as C_FOLDER
    class "WorkspaceUserController / MeController\nResourceByRAModel(WorkspaceUser)\nPagination/Direkter Zugriff" as C_USER
    class "ServerSettingsMiddleware\nEine direkte Antwort\nohne Modell RestAlchemy" as C_SERVER
}

package "3. Lese- und Berechnungsmodelle" as VIEWS {
    entity "messenger_api_user_messages_v1\nWurzeln: USER_MESSAGE_BINDING\nplacement.uuid -> öffentlich uuid\nbinding.uuid -> Verborgen ORM-Schlüssel" as V_MESSAGE
    entity "messenger_api_message_reactions_v1\nWurzeln: Die Reaktion ist nicht verursacht." as V_REACTION
    entity "messenger_api_user_streams_v1\nWurzeln: einzigartige Verbindung user/stream" as V_STREAM
    entity "messenger_api_stream_bindings_v1\nWurzeln: Sichtbarer Zeil-Adapter binding" as V_STREAM_BINDING
    entity "messenger_api_user_topics_v1\nWurzeln: einzigartige Verbindung user/topic" as V_TOPIC
    entity "messenger_api_user_folders_v1\nWurzeln: einzigartige Verbindung user/folder" as V_FOLDER
}

package "4. Proposal: - physische SQL-storable - und" as PHYSICAL {
    entity "MESSAGE\nmessenger_messages" as MESSAGE {
        uuid : UUID <<PK, - Innen canonical ID>>
        project_id
        author
        payload / source
        external_account_uuid / provider_external_id <<hidden>>
        provider / delivery
        reactions / reaction_users
        created_at / updated_at <<öffentliche>>
    }

    entity "MESSAGE_PLACEMENT\nmessenger_message_placements" as MESSAGE_PLACEMENT {
        uuid <<öffentlich UUIDv5 placement>>
        message_uuid <<FK>>
        stream / topic <<FK>>
        Einzigartig: project + message + stream + topic
    }

    entity "USER_MESSAGE_BINDING\nmessenger_user_message_bindings" as USER_MESSAGE_BINDING {
        uuid <<Verborgen identity ORM-Zeilen>>
        placement_uuid / user_uuid <<FK>>
        relation_role / visibility / permissions
        membership_generation snapshot
        Einzigartig: project + placement + user
        Ohne revision
    }

    entity "USER_MESSAGE_STATE\nmessenger_user_message_states" as USER_MESSAGE_STATE {
        placement_uuid / user_uuid <<FK>>
        membership_generation <<snapshot>>
        read / mentioned / starred / pinned
        Einzigartig: project + user + placement
    }

    entity "MESSAGE_REACTION_FACT\nmessenger_message_reaction_facts\nEinzigartig: project + message + user + emoji" as REACTION_FACT
    entity "STREAM\nmessenger_streams" as STREAM {
        owner_uuid <<- und nicht FK - Auf user>>
        direct_user_uuid <<nullable - und nicht FK - Auf user>>
        private
    }
    entity "USER_STREAM_BINDING\nmessenger_stream_bindings" as STREAM_BINDING {
        user_uuid / stream_uuid <<Einzigartig, FK>>
        Einzigartig: project + user + stream
        role / notification
        active / membership_generation
        Nichtgelesenes zählen / last_message_uuid
    }
    entity "TOPIC\nmessenger_topics" as TOPIC
    entity "USER_TOPIC_BINDING\nmessenger_user_topic_bindings" as TOPIC_BINDING {
        user_uuid / topic_uuid <<Einzigartig, FK>>
        Einzigartig: project + user + topic
        Flaggen / notification / Nichtgelesenes zählen
    }
    entity "FOLDER\nmessenger_folders" as FOLDER
    entity "USER_FOLDER_BINDING\nmessenger_user_folder_bindings" as FOLDER_BINDING {
        user_uuid / folder_uuid <<Einzigartig, FK>>
        Einzigartig: project + user + folder
        rule / type
        unread_count / mention_count
        folder_items_snapshot : JSONB <<read-only>>
        snapshot_version / snapshot_updated_at <<internal>>
    }
    entity "FOLDER_ITEM\nmessenger_folder_items" as FOLDER_ITEM {
        user_uuid / folder_uuid / stream_uuid <<FK>>
        automatic
        Einzigartig: project + user + folder + stream
    }
    entity "USER\nmessenger_users" as USER
    entity "DOMAIN_OUTBOX_EVENT\nmessenger_domain_outbox_events\nUnveränderlich" as OUTBOX_EVENT
    entity "PROJECTION_TASK\nmessenger_projection_tasks\n1 immutable task - Auf outbox event" as PROJECTION_TASK {
        unique outbox_event_uuid
        scope_kind / exact scope_key
        pending / leased / running / completed / failed / DLQ
        lease expiry / owner / fencing token
        attempts / next_retry_at
    }
    entity "SCOPE_LEASE\nmessenger_projection_scope_leases" as SCOPE_LEASE {
        unique project + scope_kind + scope_key
        lease owner / expiry / fencing token
    }
    entity "PUBLIC_EVENT_RECORD\nm_workspace_events\nwird atomar mit state;\ndispatchable Nachher commit" as PUBLIC_EVENT
}

package "5. Hintergrundmaterialisierung" as BACKGROUND {
    class "Schlot worker mit ausschließlichem Besitz exact scope\nLiest den letzten Ausgangszustand ab" as WORKER
    class "- Ein Dispatcher. WebSocket\nVersenden + Wiederholen + Wiederholen" as WS_DISPATCHER
}

