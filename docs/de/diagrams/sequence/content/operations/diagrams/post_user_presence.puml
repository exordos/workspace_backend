@startuml
!pragma layout smetana
skinparam shadowing false
title POST /api/workspace/v1/users/{user_uuid}/actions/presence/invoke
actor "Der Client" as Client
participant "- Überwacher RestAlchemy" as API
database "Benutzer Workspace in PostgreSQL" as DB
queue "Transaktions- outbox" as OUT
queue "delivery_snapshot_event\nexact user scope" as TASK
participant "Ein Wurkerpool" as WORKER
database "Speicher für öffentliche Veranstaltungen" as EVENT
participant "- Das ist der Controller . WebSocket" as DISP
participant "Kunden Workspace" as WS
participant "Zulip Bridge / Zulip" as ZULIP
Client -> API: POST JSON Anwesenheit
API -> DB: BEGIN; Überprüfen/Sperren eines eigenen Benutzers
API -> DB: Anwesenheit aktualisieren + last_ping_at
API -> OUT: Anwesenheitsänderung hinzufügen
API -> DB: COMMIT
API --> Client: 200 JSON Benutzer
OUT -> TASK: immutable delivery_snapshot_event(outbox_event_uuid)
TASK -> WORKER: Lesen Sie den letzten Benutzer aus
WORKER -> EVENT: bereit sein user.updated für jedes Projekt
DISP -> EVENT: Senden/Wiederholen/Wiederholen
DISP -> WS: user.updated
OUT -> ZULIP: durable mapped presence operation
note right of ZULIP
  Das letzte confirmed Die Veränderung siegt..
  origin/causation Sie unterdrückt. echo,
  Aber sie wählt nicht. winner.
end note
@enduml
