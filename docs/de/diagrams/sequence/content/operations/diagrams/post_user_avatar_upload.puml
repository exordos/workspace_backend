@startuml
!pragma layout smetana
skinparam shadowing false
title POST /api/workspace/v1/users/{user_uuid}/actions/avatar_upload/invoke
actor "Der Client" as Client
participant "- Überwacher RestAlchemy" as API
database "Einstellungen für den Dateispeicher" as STORE
database "Benutzer Workspace in PostgreSQL" as DB
queue "Transaktions- outbox" as OUT
queue "delivery_snapshot_event\nexact user scope" as TASK
participant "Ein Wurkerpool" as WORKER
database "Speicher für öffentliche Veranstaltungen" as EVENT
participant "- Das ist der Controller . WebSocket" as DISP
participant "Kunden Workspace" as WS
Client -> API: POST multipart mit Avatar
API -> API: Überprüfen MIME/Signatur/Größe
API -> STORE: Speichern von Bytes + öffentlichen zugehörigen Metadaten
API -> DB: BEGIN; Metadaten der Datei einfügen + Avatar aktualisieren
API -> OUT: Anzeigen von Domain-Änderungen
API -> DB: COMMIT
API --> Client: 201 JSON Benutzer
API -> STORE: entfernen Sie den übertragenen Avatar, wenn er nicht verlinkt ist
OUT -> TASK: Einzelne immutable delivery_snapshot_event\nJede hat ihre outbox_event_uuid + exact scope
TASK -> WORKER: Lesen Sie den letzten Benutzer aus
WORKER -> EVENT: bereit sein user.updated
DISP -> EVENT: Senden/Wiederholen/Wiederholen
DISP -> WS: user.updated
@enduml
