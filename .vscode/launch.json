{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Workspace API",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.tox/develop/bin/python",
            "module": "workspace.cmd.workspace_api",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config-file",
                "${workspaceFolder}/etc/workspace/workspace.local.conf"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "preLaunchTask": "Workspace: Start nginx"
        },
        {
            "name": "Python Debugger: Messenger Events",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.tox/develop/bin/python",
            "module": "workspace.cmd.messenger_events",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config-file",
                "${workspaceFolder}/etc/workspace/workspace.local.conf"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true
        },
        {
            "name": "Python Debugger: Messenger Worker",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.tox/develop/bin/python",
            "module": "workspace.cmd.messenger_worker",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config-file",
                "${workspaceFolder}/etc/workspace/workspace.local.conf"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true
        },
        {
            "name": "Python Debugger: History Import",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.tox/develop/bin/python",
            "module": "workspace.cmd.history_import",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config-file",
                "${workspaceFolder}/etc/workspace/workspace.local.conf"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true
        },
        {
            "name": "Python Debugger: Apply Migrations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.tox/develop/bin/ra-apply-migration",
            "args": [
                "--config-file",
                "${workspaceFolder}/etc/workspace/workspace.local.conf",
                "-p",
                "migrations"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/.tox/develop/bin/python",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python Debugger: Rollback Migrations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.tox/develop/bin/ra-rollback-migration",
            "args": [
                "--config-file",
                "${workspaceFolder}/etc/workspace/workspace.local.conf",
                "-p",
                "migrations",
                "-m",
                "${input:rollbackMigration}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/.tox/develop/bin/python",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Integration tests (messenger_api)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "workspace/tests/integration",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/.tox/develop/bin/python",
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "rollbackMigration",
            "type": "promptString",
            "description": "Migration to roll back, including its dependent migrations (filename or prefix)"
        }
    ],
    "compounds": [
        {
            "name": "Workspace: All Backend Services",
            "configurations": [
                "Python Debugger: Workspace API",
                "Python Debugger: Messenger Events",
                "Python Debugger: Messenger Worker",
                "Python Debugger: History Import"
            ],
            "stopAll": true
        }
    ]
}
